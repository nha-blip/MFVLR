# ==============================================================================
# MFVLR / GenFace-Reproduced: Server Environment Configuration Template
# Copy this file to server.env on the SLURM server and adjust paths and settings:
#   cp configs/server.env.example configs/server.env
# ==============================================================================

# Base project root on the SLURM server (absolute path to slurm_package directory)
# Example: /scratch/project/MFVLR/slurm_package
PROJECT_ROOT=

# Path to pristine source datasets directory containing CelebA, CelebA-HQ, FFHQ
# Example: /scratch/datasets/MFVLR_Sources
DATA_ROOT=

# Path to pre-downloaded official model checkpoints directory
# Example: /scratch/models/MFVLR_Checkpoints
CHECKPOINT_ROOT=

# Path to output directory where generated images, masks, and metadata will be saved
# Example: /scratch/project/MFVLR/production_output
OUTPUT_ROOT=

# Conda/Mamba environment name containing PyTorch + CUDA dependencies
# Example: mfvlr_a100
CONDA_ENV=mfvlr_a100

# SLURM Cluster Specifics (Leave blank if cluster defaults should be used)
SLURM_PARTITION=
SLURM_ACCOUNT=
SLURM_QOS=

# Maximum concurrent array tasks (adjust based on allocated A100 GPU quota)
# Example: 4 for a 4-GPU allocation, 8 for an 8-GPU allocation
MAX_CONCURRENT_TASKS=4
